# Copy to .env.local and fill in real values. Never commit real values.

# --- Existing site ---
DATABASE_URL=                # Neon Postgres (read-only role preferred for the coordinator dashboard)
HUBSPOT_ACCESS_TOKEN=        # existing site HubSpot integration (lookup/submit forms)
ADMIN_SESSION_SECRET=        # site admin (/admin) session signing secret

# --- Book Fair Admin Dashboard (coordinator-facing, strictly read-only) ---
HUBSPOT_PRIVATE_APP_TOKEN=   # read-only scopes: crm.objects.{deals,companies,contacts}.read + schemas
                             # (falls back to HUBSPOT_ACCESS_TOKEN until this is provisioned)
HUBSPOT_MARKETING_TOKEN=     # email audit ONLY: private app with just the content + automation scopes.
                             # Never reuse the CRM tokens here (deals.write + live n8n webhook).
BIGCOMMERCE_API_TOKEN=       # read-only Customers scope
BIGCOMMERCE_STORE_HASH=2fsgnphxqm
AUTH_JWT_SECRET=             # 32+ random bytes for signing magic-link + session JWTs
EMAIL_FROM=                  # sender address for magic links
RESEND_API_KEY=              # Resend API key (magic-link email delivery)
NEXT_PUBLIC_APP_URL=         # base URL for magic-link construction, e.g. https://www.ignatiusbookfairs.com
