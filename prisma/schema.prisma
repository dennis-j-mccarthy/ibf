// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model FAQ {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  slug      String?
  pageTitle String?
  version   String   @default("Public") // "Public", "Catholic", "Both", or comma-separated "Catholic,Public"
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resource {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String   @unique
  description  String?
  thumbnail    String?  // Image URL
  fileUrl      String?  // Direct file URL
  category     String?  // Operational, Advertising, Public, Tutorials
  audience     String?  // "Catholic In Person", "Catholic Virtual", "Parish In Person", "Public In Person"
  resourceType String?  // PDF, Video, Image, etc.
  embedCode    String?  // For YouTube/Loom embeds
  featured     Boolean  @default(false)
  hasDetails   Boolean  @default(false)
  parentGuide  String?  // Parent operational guide slug (book-fair-administrator-operational-guide, parish-book-fair-administrator-operational-guide, virtual-book-fair-operational-guide, public-book-fair-administrator-operational-guide)
  order        Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Blog {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  content         String    // Rich HTML content
  summary         String?   // Short description/excerpt
  thumbnail       String?   // Main image URL
  thumbnailSmall  String?   // Small thumbnail URL
  category        String?   // Catholic, Public, etc.
  color           String?   // Accent color for the post
  embedHtml       String?   // Custom embed HTML content
  featuredBooks   Json?     // [{url,title,image,sku}] fetched from shop.ignatiusbookfairs.com
  featured        Boolean   @default(false)
  archived        Boolean   @default(false)
  starred         Boolean   @default(false)  // queued for the next newsletter
  newsletteredAt  DateTime?                  // stamped when a newsletter featuring it went out
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// AI-generated promo kit for a blog post: per-platform promo copy (instagram /
// facebook / x / email) as JSON, one per post. Filled by the admin "generate
// promos" action.
model PromoKit {
  id        Int      @id @default(autoincrement())
  blogId    Int      @unique
  content   String   // JSON: { instagram: [...], facebook: [...], x: [...], email: {...} }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  title     String
  blurb     String
  type      String   @default("Public") // "Public", "Catholic", or empty for both
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormFunnelEvent {
  id          Int      @id @default(autoincrement())
  sessionId   String   // Unique session identifier
  event       String   // form_step1_completed, form_step2_completed, appointment_shown, etc.
  orgType     String?
  schoolType  String?
  state       String?
  rep         String?
  properties  String?  // JSON string for additional properties
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([event])
  @@index([createdAt])
}

// Chatbot knowledge base. Separate from the public-facing FAQ model on purpose --
// these power the HubSpot bot's noindexed source pages, not the on-site FAQ accordion.
model BotAnswer {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  slug      String   @unique
  links     Json?    // [{ label: string, url: string }]
  audience  String?  // "Catholic", "Public", or "Both"
  category  String?  // free-form grouping (e.g. "Pricing", "Logistics")
  order     Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Admin login accounts for the /admin area. Passwords are scrypt-hashed.
model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Brand "training" — a single editable profile that informs the blog + social
// generators. Compiled into a brand brief injected into both system prompts.
model TrainingProfile {
  id           Int      @id @default(1) // singleton row
  audiences    Json     @default("[]")  // [{ audience, statements: string[], angles: string[] }]
  colors       Json     @default("[]")  // [{ name, hex }]
  fonts        Json     @default("[]")  // [{ name, usage }]
  socialPrefs  String   @default("")    // freeform social-media guidance
  articlePrefs String   @default("")    // freeform article guidance
  updatedAt    DateTime @updatedAt
}

// A saved tutorial video (recorded in /admin/tutorials/record, stored on Vercel
// Blob). Kept in its own table so sync-resources.ts (which wipes Resource) can't
// touch it.
model Tutorial {
  id          Int      @id @default(autoincrement())
  title       String
  url         String // Vercel Blob URL
  contentType String   @default("video/mp4")
  size        Int      @default(0) // bytes
  createdAt   DateTime @default(now())
}

// A tagged brand image (kids, book fairs, parents, teachers, admins, doodads).
// Feeds the social photo-hero backgrounds + blog thumbnail suggestions.
model TrainingImage {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String   @default("")
  category  String   @default("other") // kids|bookfairs|parents|teachers|admins|doodads|other
  audience  String   @default("")      // optional target audience
  tags      String[] @default([])
  source    String   @default("url")   // url|blob
  createdAt DateTime @default(now())
}
